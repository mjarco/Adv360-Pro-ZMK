#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
    };

    combos {
        compatible = "zmk,combos";

        switch-layer-2 {
            bindings = <&mo 3>;
            key-positions = <66 69>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESCAPE        &kp N1     &kp N2   &kp N3     &kp N4     &kp N5  &none                                                               &mo 3                            &kp N6  &kp N7               &kp N8           &kp N9    &kp N0      &kp GRAVE
&kp TAB           &kp Q      &kp W    &kp E      &kp R      &kp T   &none                                                               &hm RCTRL C_VOLUME_UP            &kp Y   &kp U                &kp I            &kp O     &kp P       &kp BSLH
&kp LEFT_CONTROL  &lt 1 A    &lt 2 S  &kp D      &kp F      &kp G   &none     &kp LCTRL         &kp LALT      &kp LGUI   &kp RIGHT_ALT  &hm RIGHT_COMMAND C_VOLUME_DOWN  &kp H   &mt RIGHT_COMMAND J  &mt RCTRL K      &kp L     &lt 2 SEMI  &kp SQT
&kp LSHFT         &kp Z      &kp X    &kp C      &kp V      &kp B                               &kp HOME      &kp PG_UP                                                  &kp N   &kp M                &kp COMMA        &kp DOT   &kp FSLH    &kp RSHFT
&mo 2             &kp GRAVE  &mo 1    &kp EQUAL  &kp MINUS          &kp BSPC  &kp LEFT_COMMAND  &kp END       &kp PG_DN  &kp ENTER      &kp SPACE                                &kp LEFT_BRACE       &kp RIGHT_BRACE  &kp LBKT  &kp RBKT    &mo 3
            >;
        };

        keypad {
            bindings = <
&kp EQUAL  &kp N1     &kp N2     &kp N3    &kp N4      &kp N5       &trans                                                              &mo 4      &kp N6     &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE     &kp KP_MULTIPLY    &trans
&trans     &trans     &kp F1     &kp F2    &kp F3      &kp F4       &none                                                               &none      &kp F5     &kp F6      &kp F8        &kp LT            &kp GT             &kp F12
&trans     &trans     &kp TILDE  &kp HASH  &kp DOLLAR  &kp PERCENT  &none     &kp LCTRL         &kp LALT      &kp LGUI   &kp RIGHT_ALT  &none      &kp COLON  &kp MINUS   &kp EQUAL     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans     &trans     &trans     &trans    &trans      &trans                                   &kp HOME      &kp PG_UP                            &trans     &kp UNDER   &kp PLUS      &kp LEFT_BRACE    &kp RIGHT_BRACE    &trans
&mo 3      &kp GRAVE  &trans     &trans    &trans                   &kp BSPC  &kp LEFT_COMMAND  &kp END       &kp PG_DN  &kp ENTER      &kp SPACE             &trans      &trans        &trans            &trans             &mo 4
            >;
        };

        fn {
            bindings = <
&none   &kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6                                      &mo 4   &kp F7           &kp F8     &kp F9          &kp F10           &kp F11            &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                       &none   &kp C_VOLUME_UP  &kp PG_DN  &kp UP_ARROW    &kp PG_UP         &trans             &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none   &trans  &trans      &trans  &trans  &none   &kp C_VOL_DN     &kp LEFT   &kp DOWN_ARROW  &kp RIGHT         &trans             &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans      &trans                  &trans           &kp MINUS  &kp PLUS        &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans      &trans  &trans  &trans                   &trans     &trans          &trans            &trans             &trans
            >;
        };

        mod {
            bindings = <
&none           &trans        &trans        &trans  &trans      &trans  &none                                            &trans                  &none  &none       &none             &none              &none  &none
&none           &bt BT_SEL 0  &bt BT_SEL 1  &none   &none       &none   &bootloader                                      &bootloader             &none  &none       &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &none  &none
&none           &none         &none         &none   &none       &none   &none        &trans  &trans      &trans  &trans  &rgb_ug RGB_MEFS_CMD 5  &none  &trans      &kp CARET         &kp DOLLAR         &none  &none
&kp LEFT_SHIFT  &none         &none         &none   &macro_ver  &none                        &trans      &none                                   &none  &none       &none             &none              &none  &kp RIGHT_SHIFT
&none           &none         &none         &none   &none               &kp DELETE   &trans  &trans      &none   &trans  &trans                         &bl BL_INC  &bl BL_DEC        &none              &none  &trans
            >;
        };
    };
};
